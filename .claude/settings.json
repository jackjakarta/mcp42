{
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",

      "Bash(pnpm format *)",
      "Bash(pnpm format:check *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm types *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm checks *)",
      "Bash(pnpm db:generate *)",

      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",

      "mcp__stitch__list_projects",
      "mcp__stitch__get_project",
      "mcp__stitch__list_screens",
      "mcp__stitch__get_screen",

      "mcp__mcpFortyTwo__get-key",
      "mcp__mcpFortyTwo__get-scale",
      "mcp__mcpFortyTwo__get-chord",
      "mcp__mcpFortyTwo__generate-progression-midi",
      "mcp__mcpFortyTwo__generate-bassline-midi",
      "mcp__mcpFortyTwo__generate-drum-pattern-midi"
    ],
    "deny": ["Bash(psql *)", "Bash(pnpm db:migrate *)", "Bash(pnpm db:seed *)"]
  },
  "enabledMcpjsonServers": ["stitch", "mcpFortyTwo"],
  "disabledMcpjsonServers": []
