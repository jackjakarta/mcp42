{
  "name": "mcp42",
  "version": "0.4.5",
  "private": true,
  "description": "MCP Server for chord analysis and MIDI generation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist public/docs && tsc && pnpm docs:build",
    "checks": "$(git rev-parse --show-toplevel)/scripts/checks.sh",
    "db:generate": "drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "db:seed": "tsx src/db/seed/music.ts",
    "db:snapshot": "tsx scripts/prepare-sqlite.ts",
    "dev": "envee -f .env -- tsx watch src/index.ts",
    "docs:build": "pnpm docs:gen && pnpm --dir docs-src install --frozen-lockfile && pnpm --dir docs-src build",
    "docs:dev": "pnpm docs:gen && pnpm --dir docs-src dev",
    "docs:gen": "tsx scripts/generate-tool-docs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "envee -f .env -- tsx src/index.ts",
    "start:prod": "envee -f .env -- node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc --noEmit && tsc -p api --noEmit",
    "vercel-build": "pnpm docs:build && pnpm db:migrate && SQLITE_READONLY=0 pnpm db:seed && pnpm db:snapshot"
  },
  "dependencies": {
    "@better-fetch/fetch": "1.1.21",
    "@hono/node-server": "2.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.9.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.14",
    "midi-writer-js": "3.2.1",
    "tonal": "6.4.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@jackjakarta/prettier-config": "0.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.5.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.4"
  },
  "packageManager": "pnpm@9.15.3"
}
